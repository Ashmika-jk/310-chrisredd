---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const database = getDatabase();
const categories = await getAllCategories(database);
const publishers = await getAllPublishers(database);
const games = await getAllGames(database);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form method="get" class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <fieldset>
          <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <p class="mb-2 block text-sm font-medium text-slate-300">Categories</p>
              <div class="space-y-2">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-slate-300" data-testid={`category-filter-${category.id}`}>
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <a
              href="/"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </a>
          </div>
        </fieldset>
      </form>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <p class="hidden text-slate-300" data-testid="filtered-empty-state" role="status" aria-live="polite">
        No games match the selected filters.
      </p>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (form && emptyState) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    const selectedPublisher = params.get('publisher') ?? '';
    const categoryInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="category"]')];
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.has(input.value);
    });
    if (publisherInput) {
      publisherInput.value = selectedPublisher;
    }

    const filterCards = (): void => {
      const filteredCards = cards.filter((card) => {
        const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(card.dataset.gameCategoryId ?? '');
        const publisherMatches = selectedPublisher === '' || selectedPublisher === (card.dataset.gamePublisherId ?? '');
        card.hidden = !(categoryMatches && publisherMatches);
        return categoryMatches && publisherMatches;
      });
      emptyState.classList.toggle('hidden', filteredCards.length > 0);
    };

    filterCards();
  }
</script>
